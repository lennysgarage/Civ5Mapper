{
  "name": "civmapper",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Civilization V save and replay maps, in your browser or terminal",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "civmapper": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "dist/core",
    "dist/viewer",
    "assets",
    "LICENSE",
    "NOTICE",
    "third_party"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "import": "./dist/core/src/index.js"
    },
    "./ruleset": "./dist/core/src/ruleset.js",
    "./raster": "./dist/core/src/raster.js",
    "./html": "./dist/core/src/html.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "predev": "node scripts/build.mjs --assets-only",
    "dev": "vite --config packages/web/vite.config.ts",
    "preview": "vite preview --config packages/web/vite.config.ts",
    "test": "node --test --experimental-test-isolation=none tests-ts/*.test.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json",
    "prepack": "npm run build",
    "format": "prettier --write packages scripts/*.mjs tests-ts/*.mjs package.json tsconfig*.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "commander": "^14.0.0",
    "gifenc": "^1.0.3",
    "pako": "3.0.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
