{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "packages",
    "declaration": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"]
  },
  "include": ["packages/core/src/**/*.ts", "packages/cli/src/**/*.ts"],
  "exclude": ["packages/web"]
}
